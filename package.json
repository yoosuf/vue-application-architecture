{
  "name": "vue-application-architecture",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "build": "pnpm --filter frontend build",
    "preview": "pnpm --filter frontend preview",
    "demo:types": "pnpm --filter @vue-application-architecture/types demo",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:watch": "pnpm -r --if-present test:watch",
    "lint": "pnpm -r --if-present lint",
    "format": "prettier --write apps packages .prettierrc.json"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@stylexjs/babel-plugin": "^0.19.1",
    "@stylexjs/unplugin": "^0.19.1",
    "@types/babel__core": "^7.20.5",
    "@types/estree": "^1.0.9",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.11.0",
    "eslint-plugin-vue": "^10.11.1",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "unplugin": "^2.3.11",
    "vite": "^8.3.0",
    "vue-tsc": "^3.3.11"
  }
}