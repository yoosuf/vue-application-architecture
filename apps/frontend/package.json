{
  "name": "frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "demo": "vite --config vite.demo.config.ts",
    "demo:build": "vite build --config vite.demo.config.ts",
    "typecheck": "vue-tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"config/**/*.ts\" \"tests/**/*.ts\" \"demo/**/*.{ts,vue,css}\""
  },
  "dependencies": {
    "@faker-js/faker": "^10.6.0",
    "@vue-application-architecture/design-system": "workspace:*",
    "@vue-application-architecture/types": "workspace:*",
    "@stylexjs/stylex": "^0.19.1",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.5.1",
    "happy-dom": "^20.14.5",
    "vitest": "^5.0.1"
  }
}
